{
  "name": "prism",
  "version": "1.4.1",
  "description": "A local-first Markdown editor for writing, preview typography, and reliable export.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:app-smoke": "tauri build --config src-tauri/tauri.local-smoke.conf.json --bundles app && node scripts/patch-macos-document-icons.mjs && node scripts/run-app-smoke.mjs",
    "icons:generate": "node scripts/generate-brand-icons.mjs && node scripts/generate-document-icons.mjs",
    "icons:documents": "node scripts/generate-document-icons.mjs",
    "macos:patch-document-icons": "node scripts/patch-macos-document-icons.mjs",
    "macos:register-markdown-default": "node scripts/register-macos-markdown-default.mjs",
    "release:mac-dmg:skip-finder": "bash scripts/package-macos-dmg-skip-finder.sh",
    "release:manifest": "node scripts/generate-updater-manifest.mjs",
    "release:manifest:check": "node scripts/generate-updater-manifest.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexPlum405/Prism.git"
  },
  "keywords": [
    "markdown",
    "tauri",
    "editor",
    "writing"
  ],
  "author": "Prism contributors",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.0.2",
    "png-to-ico": "^3.0.1",
    "puppeteer": "^24.42.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@kookyleo/graphviz-anywhere-web": "^0.2.1",
    "@kookyleo/plantuml-little-web": "^1.2026.2-3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "^6.0.2",
    "docx": "^9.6.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.45",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.14.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.12"
  }
}
