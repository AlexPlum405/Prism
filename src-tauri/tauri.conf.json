{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Prism",
  "version": "1.0.0",
  "identifier": "com.prism.editor.v1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/patch-windows-exe-icon.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Prism",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQTlFMUU5QTIyNEY0QjAKUldTdzlDU2k2ZUdwM1F1S3dKenoyL3dUbmZsZTlIVjFkZXBNQTFvRFNhdWtWRXdUSFJMMkZ5Y0MK",
      "endpoints": [
        "https://github.com/AlexPlum405/Prism/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/Initial": "Initial",
      "icons/document-markdown.icns": "PrismMarkdownSignatureDocument.icns",
      "icons/document-text.icns": "PrismTextDocument.icns"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "contentTypes": [
          "com.prism.editor.markdown",
          "net.daringfireball.markdown",
          "public.markdown",
          "net.ia.markdown",
          "com.unknown.md"
        ],
        "name": "Prism Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.prism.editor.markdown",
          "conformsTo": ["public.text"]
        }
      },
      {
        "ext": [
          "txt",
          "text",
          "sql",
          "json",
          "jsonc",
          "yaml",
          "yml",
          "toml",
          "xml",
          "csv",
          "tsv",
          "log",
          "ini",
          "conf",
          "env"
        ],
        "contentTypes": [
          "com.prism.editor.text",
          "public.plain-text",
          "public.text",
          "public.source-code",
          "public.json",
          "public.yaml",
          "public.xml",
          "public.comma-separated-values-text",
          "public.tab-separated-values-text",
          "org.iso.sql"
        ],
        "name": "Prism Text Document",
        "description": "Text Document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Default",
        "exportedType": {
          "identifier": "com.prism.editor.text",
          "conformsTo": ["public.text"]
        }
      }
    ]
  }
}
